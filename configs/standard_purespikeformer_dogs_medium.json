{
  "name": "standard_purespikeformer_dogs_medium",
  "dataset": "dogs_medium",
  "data_root": "data/dogs",
  "split_manifest": "data/teacher_cache/dogs_medium/student_split.json",
  "target_cache": "data/teacher_cache/dogs_medium/observable.pt",
  "steps": 16,
  "size": 48,
  "frame_mode": "count_global",
  "dim": 384,
  "depth": 4,
  "heads": 6,
  "patch_size": 4,
  "threshold": 0.5,
  "block_spiking": "full_respike",
  "qkv_temporal_mode": "standard",
  "signed_readout": true,
  "multidepth_readout": true,
  "multidepth_readout_layers": 3,
  "membrane_readout": false,
  "epochs": 175,
  "batch_size": 32,
  "max_fit": 8000,
  "max_validation": 1000,
  "lr": 0.001,
  "weight_decay": 0.01,
  "observable_weight": 10.0,
  "geometry_weight": 1.0,
  "temporal_weight": 0.0,
  "temporal_rate_weight": 0.0,
  "confidence_floor": 0.0,
  "augment": false,
  "labels_used": false,
  "seed": 42
}
